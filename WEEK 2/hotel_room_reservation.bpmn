<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="D_hotel_room_reservation" targetNamespace="http://example.com/bpmn/lab">
  <process id="hotel_room_reservation" name="Hotel Room Reservation" isExecutable="false">
    <startEvent id="start" name="Booking Request Submitted" />
    <userTask id="t1" name="Submit Room Booking Request" />
    <serviceTask id="t2" name="Check Room Availability" />
    <exclusiveGateway id="g1" name="Rooms Available?" />
    <sendTask id="t3" name="Notify: No Rooms Available" />
    <endEvent id="end1" name="Reservation Ended" />
    <userTask id="t4" name="Make Advance/Deposit Payment" />
    <serviceTask id="t5" name="Process Payment" />
    <exclusiveGateway id="g2" name="Payment Successful?" />
    <serviceTask id="t6" name="Confirm Booking &amp; Generate Reference" />
    <sendTask id="t7" name="Send Booking Confirmation Email" />
    <endEvent id="end2" name="Booking Completed" />
    <sendTask id="t8" name="Notify: Payment Failed" />
    <endEvent id="end3" name="Reservation Ended" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="No">
      <conditionExpression xsi:type="tFormalExpression">roomsAvailable = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="t3" targetRef="end1" />
    <sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="Yes">
      <conditionExpression xsi:type="tFormalExpression">roomsAvailable = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" sourceRef="t4" targetRef="t5" />
    <sequenceFlow id="f8" sourceRef="t5" targetRef="g2" />
    <sequenceFlow id="f9" sourceRef="g2" targetRef="t6" name="Yes">
      <conditionExpression xsi:type="tFormalExpression">paymentSuccessful = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f10" sourceRef="t6" targetRef="t7" />
    <sequenceFlow id="f11" sourceRef="t7" targetRef="end2" />
    <sequenceFlow id="f12" sourceRef="g2" targetRef="t8" name="No">
      <conditionExpression xsi:type="tFormalExpression">paymentSuccessful = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f13" sourceRef="t8" targetRef="end3" />
  </process>
  <bpmndi:BPMNDiagram id="DG_hotel_room_reservation" />

<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="D_job_applicant_recruitment" targetNamespace="http://example.com/bpmn/lab">
  <process id="job_applicant_recruitment" name="Job Applicant Recruitment" isExecutable="false">
    <startEvent id="start" name="Job Application Submitted" />
    <userTask id="t1" name="Submit Job Application Online" />
    <serviceTask id="t2" name="Screen Application Against Eligibility Criteria" />
    <exclusiveGateway id="g1" name="Eligible?" />
    <sendTask id="t3" name="Send Rejection Notification" />
    <endEvent id="end1" name="Recruitment Ended" />
    <userTask id="t4" name="Schedule Technical Interview" />
    <userTask id="t5" name="Conduct / Evaluate Technical Interview" />
    <exclusiveGateway id="g2" name="Technical Interview Passed?" />
    <sendTask id="t6" name="Send Rejection Notification" />
    <endEvent id="end2" name="Recruitment Ended" />
    <userTask id="t7" name="Schedule HR / Managerial Round" />
    <userTask id="t8" name="Conduct / Evaluate HR Round" />
    <exclusiveGateway id="g3" name="Selected?" />
    <serviceTask id="t9" name="Generate Offer Letter" />
    <sendTask id="t10" name="Send Offer Letter" />
    <endEvent id="end3" name="Offer Sent" />
    <sendTask id="t11" name="Send Rejection Notification" />
    <endEvent id="end4" name="Recruitment Ended" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="No">
      <conditionExpression xsi:type="tFormalExpression">eligible = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="t3" targetRef="end1" />
    <sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="Yes">
      <conditionExpression xsi:type="tFormalExpression">eligible = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" sourceRef="t4" targetRef="t5" />
    <sequenceFlow id="f8" sourceRef="t5" targetRef="g2" />
    <sequenceFlow id="f9" sourceRef="g2" targetRef="t6" name="Fail">
      <conditionExpression xsi:type="tFormalExpression">technicalPassed = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f10" sourceRef="t6" targetRef="end2" />
    <sequenceFlow id="f11" sourceRef="g2" targetRef="t7" name="Pass">
      <conditionExpression xsi:type="tFormalExpression">technicalPassed = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f12" sourceRef="t7" targetRef="t8" />
    <sequenceFlow id="f13" sourceRef="t8" targetRef="g3" />
    <sequenceFlow id="f14" sourceRef="g3" targetRef="t11" name="Rejected">
      <conditionExpression xsi:type="tFormalExpression">selected = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f15" sourceRef="t11" targetRef="end4" />
    <sequenceFlow id="f16" sourceRef="g3" targetRef="t9" name="Selected">
      <conditionExpression xsi:type="tFormalExpression">selected = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f17" sourceRef="t9" targetRef="t10" />
    <sequenceFlow id="f18" sourceRef="t10" targetRef="end3" />
  </process>

<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="D_loan_application_processing" targetNamespace="http://example.com/bpmn/lab">
  <process id="loan_application_processing" name="Loan Application Processing" isExecutable="false">
    <startEvent id="start" name="Loan Application Submitted" />
    <userTask id="t1" name="Submit Loan Application" />
    <serviceTask id="t2" name="Verify Documents &amp; Credit Score" />
    <exclusiveGateway id="g1" name="Documents Valid?" />
    <sendTask id="t3" name="Send Rejection Notification" />
    <endEvent id="end1" name="Application Ended" />
    <serviceTask id="t4" name="Check Loan Eligibility" />
    <exclusiveGateway id="g2" name="Applicant Eligible?" />
    <sendTask id="t5" name="Send Rejection Notification" />
    <endEvent id="end2" name="Application Ended" />
    <serviceTask id="t6" name="Forward Request to Loan Officer" />
    <userTask id="t7" name="Final Loan Approval Decision" />
    <exclusiveGateway id="g3" name="Loan Approved?" />
    <serviceTask id="t8" name="Disburse Loan Amount" />
    <sendTask id="t9" name="Send Approval Notification" />
    <endEvent id="end3" name="Loan Process Completed" />
    <sendTask id="t10" name="Send Rejection Notification" />
    <endEvent id="end4" name="Loan Process Completed" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="Invalid / Incomplete">
      <conditionExpression xsi:type="tFormalExpression">documentsValid = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="t3" targetRef="end1" />
    <sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="Valid">
      <conditionExpression xsi:type="tFormalExpression">documentsValid = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" sourceRef="t4" targetRef="g2" />
    <sequenceFlow id="f8" sourceRef="g2" targetRef="t5" name="No">
      <conditionExpression xsi:type="tFormalExpression">eligible = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f9" sourceRef="t5" targetRef="end2" />
    <sequenceFlow id="f10" sourceRef="g2" targetRef="t6" name="Yes">
      <conditionExpression xsi:type="tFormalExpression">eligible = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f11" sourceRef="t6" targetRef="t7" />
    <sequenceFlow id="f12" sourceRef="t7" targetRef="g3" />
    <sequenceFlow id="f13" sourceRef="g3" targetRef="t8" name="Approved">
      <conditionExpression xsi:type="tFormalExpression">loanApproved = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f14" sourceRef="t8" targetRef="t9" />
    <sequenceFlow id="f15" sourceRef="t9" targetRef="end3" />
    <sequenceFlow id="f16" sourceRef="g3" targetRef="t10" name="Rejected">
      <conditionExpression xsi:type="tFormalExpression">loanApproved = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f17" sourceRef="t10" targetRef="end4" />
  </process>
  <bpmndi:BPMNDiagram id="DG_loan_application_processing" />
  <bpmndi:BPMNPlane id="PL_loan_application_processing" bpmnElement="loan_application_processing">
    <bpmndi:BPMNShape id="DI_start" bpmnElement="start">
